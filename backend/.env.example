PORT=8000
# debug | info | warn | error
LOG_LEVEL=info
JWT_SECRET=changeme

# Matches the credentials and database name in docker-compose.yaml, so this works
# as-is against `docker compose up -d postgres redis`.
POSTGRESQL_URL=postgres://postgres:secretpassword@localhost:5432/ticketingmaster

# Bare host:port — not a redis:// URL.
REDIS_URL=localhost:6379

# Registers /admin routes (mint, reset, simulate). Never enable in production.
DEMO_MODE=true

MAX_CONCURRENT_QUEUE=10
WHITELIST_TTL=45s
HEARTBEAT_TTL=30s
QUEUE_TTL=5m
PROMOTE_INTERVAL=1s
